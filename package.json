{
  "name": "food-ordering-web-app",
  "version": "1.0.0",
  "description": "Web-based food ordering system for Zimbabwean SMEs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate:neon": "node scripts/migrate-sqlite-to-neon.js",
    "sync:stock:neon": "node scripts/sync-stock-to-neon.js",
    "ml:export-foods": "node scripts/export-diet-foods.js",
    "ml:simulate": "cd ml && .venv\\Scripts\\python simulate.py",
    "ml:train": "node scripts/export-diet-foods.js && cd ml && .venv\\Scripts\\python simulate.py && .venv\\Scripts\\python train.py",
    "ml:test": "node scripts/test-diet-ml.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": "22.x"
  }
}
