DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=food_ordering_db
SESSION_SECRET=generate_a_random_secret_of_at_least_32_characters
APP_BASE_URL=https://your-app.example.com
FITBIT_CLIENT_ID=your_fitbit_application_client_id
FITBIT_CLIENT_SECRET=your_fitbit_application_client_secret
FITBIT_REDIRECT_URI=https://your-app.example.com/api/diet/fitbit/callback
FITBIT_TOKEN_ENCRYPTION_KEY=generate_a_random_secret_of_at_least_32_characters
# Reset emails, option 1: Google Apps Script mail relay over HTTPS (see README).
# When both are set they are used instead of SMTP.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
# Reset emails, option 2: SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=THE KITCHEN <no-reply@example.com>
# Phone reminders (Web Push). Optional: if left empty, keys are created once and stored in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: protects /api/reminders/tick?key=... when it is called by a free cron service
REMINDER_CRON_SECRET=
# AI meal photo scanner (Claude vision). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: scans each student can make per day (default 15)
AI_SCANS_PER_DAY=15
# Delivery fee in dollars (default 3.50) and the kitchen's position for the tracking map
DELIVERY_FEE=3.50
KITCHEN_LAT=
KITCHEN_LNG=
# Optional: first delivery rider account, created on start if it does not exist.
# The password must be at least 14 characters. More riders: Admin > Team & security.
RIDER_USERNAME=
RIDER_PASSWORD=
RIDER_NAME=
# Optional order limits (defaults shown): plates of one item per order,
# unpaid cash orders a student can have waiting, and orders per 10 minutes.
MAX_PLATES_PER_ITEM=10
MAX_ACTIVE_CASH_ORDERS=3
MAX_ORDERS_PER_10_MINUTES=5
